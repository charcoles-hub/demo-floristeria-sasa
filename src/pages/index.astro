---
import Layout from '../layouts/Layout.astro';
import Foto from '../components/Foto.astro';

const telefono = '934 73 08 68';
const tel = 'tel:+34934730868';
const correo = 'info@sasa-artfloral.com';
const mapa = 'https://www.google.com/maps/search/?api=1&query=Sasa+Art+Floral%2C+Sant+Just+Desvern';

const portada = [
  { nombre: 'comp-bi', alto: '100%', alt: 'Composición alta de cañas verdes dentro de un cilindro de cristal, con una calla blanca arriba y bolas naranjas abajo' },
  { nombre: 'quefem-bi', alto: '70%', alt: 'Orquídeas fucsia sobre una estructura de cañas claras' },
  { nombre: 'textura-bi', alto: '86%', alt: 'Anturio verde y rosa entre hojas y cañas' },
  { nombre: 'ramsasa2', alto: '58%', alt: 'Flores amarillas sobre una estructura de alambre, con fondo verde' },
];

const ocasiones = [
  ['Ramo de cortesía', 'Para llegar a una cena, una fiesta o una reunión de amigos sin las manos vacías. Un par de flores bien trabajadas, no un ramo enorme.'],
  ['Ramo con efecto sorpresa', 'Para quien quiere ser el centro de atención. Una composición atrevida, de carácter único.'],
  ['Ramo de compromiso', 'Aniversarios, inauguraciones, finales de carrera o un agradecimiento personal. Calidad y cantidad, siempre personalizado.'],
  ['Ramo Sasa', 'Libertad creativa nuestra e intención clara tuya. Puede llevar madera, alambre o gemas junto a la flor.'],
];

const lineas = [
  ['Línea', 'Cruces de líneas y grafismos que personalizan el resultado final. Los trabajamos con madera, alambre, plástico, cuerda o fibra de vidrio.', 'linea-bi', 'Ramo de mano con flores por delante de una estructura de líneas verticales'],
  ['Textura', 'Escogemos los materiales para que no compitan entre sí: rugosos y naturales, o satinados y pulidos.', 'textura-ei', 'Ramo de rosas rojas envuelto en fibra de coco'],
  ['Color', 'Cada color transmite un estado de ánimo. Lo elegimos antes de empezar y, a veces, rompemos el tópico.', 'color2', 'Ramo de flores blancas y naranjas en tonos cálidos'],
  ['Innovación', 'Cada trabajo parte de una investigación previa: composición, material y técnica para llegar a algo nuevo.', 'innova-bi', 'Flor dentro de una estructura de alambres cruzados sobre una base roja'],
];

const bodas = [
  ['El ramo', 'Forma, color, estilo y técnica según cómo eres.'],
  ['Prendidos', 'Un detalle floral para el novio, el padrino o los padres.'],
  ['La iglesia', 'Visitamos el espacio antes de proponer. También decoramos otras localizaciones.'],
  ['El coche', 'Poca flor, bien escogida, para que el coche no se recargue.'],
  ['La fiesta', 'Mesas, cóctel o entrada del restaurante, con alternativas distintas.'],
];

const pasos = [
  ['Idea', 'Empezamos por lo que quieres transmitir. Si hace falta, dibujamos.', 'esbos', 'Esbozo a lápiz de un jarrón de cristal con flor'],
  ['Construcción', 'Elegimos la técnica constructiva. Todo trabajo incluye al menos una, como el alambrado.', 'constr-bi', 'Soporte metálico de púas para sujetar los tallos'],
  ['Composición', 'Forma, color, textura y peso óptico: primero por separado, después en conjunto.', 'cosntruccio-bi', 'Centro de mesa con juego de texturas de materiales naturales'],
  ['Resultado', 'Una síntesis entre tu voluntad y nuestra propuesta, que transmita la emoción que pides.', 'resultat-bi', 'Composición con cañas y flores blancas en un jarrón de cristal'],
];
---

<Layout
  titulo="Sasa Art Floral | Floristería y arte floral en Sant Just Desvern"
  descripcion="Ramos, composiciones y flores de boda hechos a medida en Sant Just Desvern. Llama al 934 73 08 68."
>
  <div class="franja">
    Propuesta de diseño para Sasa Art Floral · preparada por{" "}
    <a href="https://sergiogarciaweb.com" rel="noopener">Sergio García</a>
  </div>

  <header class="cabecera">
    <div class="medida cabecera-in">
      <a class="marca" href="#inicio" aria-label="Sasa art floral, inicio">
        <b>SASA</b><span>art floral</span>
      </a>
      <nav class="nav" aria-label="Principal">
        <a href="#ramos">Ramos</a>
        <a href="#composiciones">Composiciones</a>
        <a href="#bodas">Bodas</a>
        <a href="#proceso">Cómo trabajamos</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="boton boton-principal llamar-cab" href={tel}>Llamar al {telefono}</a>
    </div>
  </header>

  <main id="contenido">
    <section class="portada" id="inicio">
      <div class="medida portada-grid">
        <div>
          <h1 class="titular h1">Flores hechas a medida para cada ocasión</h1>
          <p class="texto">
            Ramos, composiciones y flores de boda pensados contigo, a partir de lo que quieres
            transmitir. Tienda y taller en Sant Just Desvern.
          </p>
          <div class="acciones">
            <a class="boton boton-principal" href={tel}>Llamar al {telefono}</a>
            <a class="boton boton-secundario" href={`mailto:${correo}`}>Escribir un correo</a>
          </div>
          <p class="valoracion">
            <a href={mapa} rel="noopener" target="_blank">4,8 en Google (52 reseñas)</a>
          </p>
        </div>
        <ul class="tallos">
          {portada.map((p, i) => (
            <li class="tallo" style={`--alto:${p.alto};--i:${i}`}>
              <figure>
                <Foto nombre={p.nombre} alt={p.alt} prioridad={true} />
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="seccion seccion-papel" id="ramos">
      <div class="medida dos-col">
        <div>
          <h2 class="titular h2">Ramos con idea</h2>
          <p class="texto" style="margin-top:1.25rem">
            Un ramo puede ser un detalle discreto o el regalo principal. Te aconsejamos sobre el más
            adecuado para la ocasión y lo preparamos a tu medida.
          </p>
          <dl class="ocasiones">
            {ocasiones.map(([t, d]) => (
              <div>
                <dt>{t}</dt>
                <dd>{d}</dd>
              </div>
            ))}
          </dl>
          <div class="acciones" style="margin-top:2rem">
            <a class="boton boton-principal" href={tel}>Llamar al {telefono}</a>
          </div>
        </div>
        <div class="escalera">
          <figure class="a">
            <Foto nombre="sorpresa-bi" alt="Ramo de girasoles sobre fondo naranja con un detalle rojo" />
            <figcaption class="pie-foto">Despedida de soltera: girasoles con un detalle picante.</figcaption>
          </figure>
          <figure class="b">
            <Foto nombre="compromis-bi" alt="Ramo de lilium naranjas, gerberas y flor amarilla" />
          </figure>
          <figure class="c">
            <Foto nombre="cortesia-bi" alt="Lilium blanco sobre cañas verdes con una bola de flor amarilla" />
          </figure>
          <figure class="ancha">
            <Foto nombre="compromis3" alt="Ramo de rosas naranjas, verde y flor amarilla sobre fibra naranja" />
          </figure>
        </div>
      </div>
    </section>

    <section class="seccion" id="composiciones">
      <div class="medida dos-col">
        <div class="sticky-col">
          <div>
            <h2 class="titular h2">Composiciones con estructura</h2>
            <p class="texto" style="margin-top:1.25rem">
              Decoraciones para celebraciones, empresas, oficinas y stands de feria. Cada pieza lleva
              una estructura que sostiene la flor y le da un carácter propio.
            </p>
          </div>
          <figure class="lamina" style="margin:0;max-width:27.4rem">
            <Foto nombre="linia-cd" alt="Mesa de despacho con un jarrón rojo y una estructura de líneas cruzadas" />
            <figcaption class="pie-foto">Composición para la mesa de un despacho de dirección.</figcaption>
          </figure>
        </div>
        <ul class="lista-lineas">
          {lineas.map(([t, d, f, a]) => (
            <li>
              <Foto nombre={f} alt={a} />
              <div>
                <h3 class="titular h3">{t}</h3>
                <p>{d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="seccion seccion-papel" id="bodas">
      <div class="medida">
        <h2 class="titular h2-grande frase">El ramo de novia debe hablar de ti</h2>
        <div class="dos-col" style="margin-top:clamp(2.5rem,6vw,4.5rem)">
          <div>
            <p class="texto">
              Proponemos forma, color, estilo y técnica teniendo en cuenta cómo eres. No es lo mismo
              una novia alta, morena y con cola que una rubia, bajita y con vestido corto. Queremos que
              tú, el ramo, el vestido y el peinado seáis una misma cosa.
            </p>
            <dl class="ocasiones">
              {bodas.map(([t, d]) => (
                <div>
                  <dt>{t}</dt>
                  <dd>{d}</dd>
                </div>
              ))}
            </dl>
            <div class="acciones" style="margin-top:2rem">
              <a class="boton boton-principal" href={tel}>Llamar al {telefono}</a>
            </div>
          </div>
          <div class="mosaico">
            <figure>
              <Foto nombre="nuvia-ram-bs" alt="Ramo de novia de flor blanquecina y hojas verdes" />
            </figure>
            <figure class="baja">
              <Foto nombre="nuvia-ram-ei" alt="Ramo de novia redondo de rosas naranjas y verde" />
            </figure>
            <figure>
              <Foto nombre="color1" alt="Ramo de novia de flores blancas y verdes" />
            </figure>
            <figure class="ancho">
              <Foto nombre="coche3" alt="Coche de novios con un pequeño adorno floral y lazos blancos" />
              <figcaption class="pie-foto">Coche de novios: sobriedad y elegancia, con muy poca flor.</figcaption>
            </figure>
            <figure class="ancho">
              <Foto nombre="festa2" alt="Mesa de banquete con un centro de rosas sobre un plato de cristal con agua naranja" />
              <figcaption class="pie-foto">Centro de mesa de rosas sobre estructura de madera y cristal.</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="seccion" id="proceso">
      <div class="medida">
        <div class="cabecera-seccion">
          <h2 class="titular h2">Cómo trabajamos</h2>
          <p class="texto">
            Cuando vienes a la tienda, te asesoramos hasta llegar a un resultado que sea, de verdad,
            el que buscabas.
          </p>
        </div>
        <ol class="pasos">
          {pasos.map(([t, d, f, a], i) => (
            <li>
              <Foto nombre={f} alt={a} />
              <div>
                <span class="num">Paso {i + 1}</span>
                <h3 class="titular h3">{t}</h3>
                <p>{d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="seccion seccion-papel" id="quien">
      <div class="medida dos-col">
        <div>
          <h2 class="titular h2">Quién está detrás de Sasa</h2>
          <p class="texto" style="margin-top:1.25rem">
            Tras el nombre hay un equipo liderado por <strong>Jordi Busquets</strong>, técnico superior
            en artes plásticas y diseño en arte floral por la Escola d’Art Floral de Catalunya.
          </p>
          <p class="texto" style="margin-top:1rem">
            Partimos de una tradición y unos valores estéticos clásicos, y los modificamos para crear
            otros nuevos. Te atendemos de forma personalizada.
          </p>
        </div>
        <div class="retratos">
          <figure>
            <Foto nombre="quisom-e" alt="Jordi Busquets montando una composición alta de flores y hojas" />
            <figcaption class="pie-foto">Jordi Busquets trabajando en una composición.</figcaption>
          </figure>
          <figure>
            <Foto nombre="a1a" alt="Jordi Busquets pintando sobre madera" />
            <figcaption class="pie-foto">Jordi Busquets ultimando la imagen corporativa de Sasa.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="seccion oscuro" id="contacto">
      <div class="medida dos-col">
        <div>
          <h2 class="titular h2">Ven a la tienda o llámanos</h2>
          <p class="texto" style="margin-top:1.25rem">
            Cuéntanos la ocasión y lo que quieres transmitir. Te proponemos una idea.
          </p>
          <a class="telefono" href={tel} style="margin-top:1.5rem">{telefono}</a>
          <div class="acciones" style="margin-top:1.5rem">
            <a class="boton boton-principal" href={tel}>Llamar al {telefono}</a>
            <a class="boton boton-secundario" href={`mailto:${correo}`}>Escribir un correo</a>
          </div>
          <dl class="datos">
            <div>
              <dt>Dirección</dt>
              <dd>Plaça Parador, 3, Sant Just Desvern</dd>
            </div>
            <div>
              <dt>Correo</dt>
              <dd><a href={`mailto:${correo}`}>{correo}</a></dd>
            </div>
            <div>
              <dt>Cómo llegar</dt>
              <dd>Sant Just está junto a Barcelona: se sale por la Diagonal en dirección a la AP-2.</dd>
            </div>
            <div>
              <dt>Valoración</dt>
              <dd><a href={mapa} rel="noopener" target="_blank">4,8 en Google (52 reseñas)</a></dd>
            </div>
          </dl>
        </div>
        <figure style="margin:0;max-width:13.25rem">
          <Foto nombre="onsom-es" alt="Fachada de la tienda Sasa Art Floral con el rótulo SASA" />
          <figcaption class="pie-foto">Fachada de la tienda.</figcaption>
        </figure>
      </div>
    </section>
  </main>

  <footer class="oscuro pie">
    <div class="medida pie-in">
      <span><b>SASA</b> art floral, Sant Just Desvern</span>
      <span>Esta página es una propuesta de diseño, no la web oficial de Sasa Art Floral.</span>
    </div>
  </footer>

  <div class="barra">
    <a class="boton boton-principal" href={tel}>Llamar al {telefono}</a>
    <a class="boton boton-secundario" href={`mailto:${correo}`}>Escribir</a>
  </div>
</Layout>
