---
import '../styles/global.css';
import fuenteLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#eef0e9" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preload" href={fuenteLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
